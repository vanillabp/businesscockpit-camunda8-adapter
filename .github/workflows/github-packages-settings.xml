<?xml version="1.0" encoding="UTF-8"?>
<!--
  Where CI reads the one VanillaBP snapshot this build needs from GitHub Packages: the Camunda 8
  adapter, org.camunda.community.vanillabp. Its namespace belongs to the Camunda Community Hub, so
  it publishes its snapshots there and not to Maven Central. GitHub Packages asks for a token even
  for a public package, so the server below carries the repository secrets VANILLABP_USER_NAME and
  VANILLABP_USER_TOKEN, a token with 'read:packages'.

  The platform, spi-for-java and the cockpit's extensions-commons come from the snapshot
  repository of Maven Central. The parent io.vanillabp:release-parent names it, and it needs no
  login.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>
    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <!-- the BPMS adapter this extension plugs into -->
                <repository>
                    <id>vanillabp-camunda8-adapter</id>
                    <url>https://maven.pkg.github.com/camunda-community-hub/vanillabp-camunda8-adapter</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <server>
            <id>vanillabp-camunda8-adapter</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
    </servers>

</settings>
