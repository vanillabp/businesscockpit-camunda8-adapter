<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>businesscockpit-camunda8-adapter-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>businesscockpit-camunda8-adapter</artifactId>
  <name>VanillaBP Business Cockpit adapter for Camunda 8 - Core</name>
  <description>Everything the Business Cockpit extension does with a Camunda 8 cluster and without knowing a platform: the listeners injected into the deployed models, the workers serving their jobs, and the bridge answering what the cockpit reads about a task or a workflow.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <!-- No platform integration is a dependency here, deliberately: this module compiles
       against the extension SPI, the platform-neutral half of the cockpit extension and the
       CORE artifact of the VanillaBP Camunda 8 adapter, and against nothing which exists only
       on Spring Boot or only on Quarkus. -->

  <dependencies>
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons</artifactId>
    </dependency>
    <dependency>
      <!-- names the processing context this extension is wired with, holds the scoping and
           listener helpers its own listeners are placed against, and hands out the Camunda
           client of each configured adapter id. It brings the Camunda client and the
           VanillaBP SPI artifacts along.
           The client is not declared here although this module uses it. A declaration needs a
           version, and the only version which is right is the one the adapter of this line
           names. So the client comes through the adapter and nowhere else, and an
           application of this line gets exactly that client. See decision 32 in the
           repository's DECISIONS.md. -->
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter</artifactId>
    </dependency>
    <dependency>
      <!-- arrives transitively as well; declared because this module implements it -->
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-extension-spi</artifactId>
    </dependency>
    <dependency>
      <!-- arrives transitively as well; declared because this module reads two of its types:
           the name-clash avoidance a workflow module was deployed under, and the registry
           which names the variable a BPMN process carries the workflow aggregate's id in.
           Nothing here implements it - that is a BPMS adapter's business. -->
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-adapter-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- brings the output suppression every VanillaBP test class registers, and with it the
        Mockito the cluster's own types are stood in with -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- holds PublishedPom, which says what the POM of a Camunda 8 adapter promises an
        application. The adapter publishes that module once per release line, so this module
        checks with the assertions of the line it compiles against and keeps no copy of its
        own. See decision 12 in the repository's DECISIONS.md.
        The class used to sit in 'camunda8-adapter-test-support', which starts clusters and
        so put Testcontainers on this module's test classpath. Nothing here wants a cluster.
        The module named here holds that one class and needs nothing but the JDK. -->
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-published-pom</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- What the active line profile chose, handed to Camunda8PublishedPomTest and
              Camunda8AdapterOfThisLineTest. The first holds the adapter version against the POM
              this module publishes. The second holds the line against the line descriptor of the
              adapter on the classpath, because the client of a build is the client of that
              adapter, and a build of line 8.8 against an adapter built for 8.10 would quietly
              run the 8.10 client. -->
            <camunda8.line>${camunda8.line}</camunda8.line>
            <camunda8-adapter.version>${camunda8-adapter.version}</camunda8-adapter.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
