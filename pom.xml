<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- the same release parent the Business Cockpit itself uses, because these artifacts are
       released to Maven Central under the cockpit's groupId and have to be signed and
       accompanied by sources and javadoc the way the rest of the cockpit is -->
  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>release-parent</artifactId>
    <version>1.2.0</version>
  </parent>

  <groupId>io.vanillabp.businesscockpit</groupId>
  <artifactId>businesscockpit-camunda8-adapter-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>VanillaBP Business Cockpit adapter for Camunda 8</name>
  <description>Business Cockpit integration for Camunda 8, built as a VanillaBP 2 extension and released once per Camunda 8 minor.</description>
  <!-- Every artifact of this repository names this one address, the root of the repository.
       Maven would otherwise append the module path to what a child inherits, here and in all
       three scm elements, and point each published POM at a page which does not exist. That
       is what the four 'child.*.inherit.append.path' attributes switch off, one on the project
       element above and three on the scm element below. A link into a module directory would
       also break as soon as a module moves, and a reader who wants the module finds it from
       the root in one click. Guarded by Camunda8PublishedPomTest, see decision 12 in the
       repository's DECISIONS.md. -->
  <url>https://github.com/vanillabp/businesscockpit-camunda8-adapter</url>

  <modules>
    <module>core</module>
    <module>spring-boot</module>
    <module>quarkus</module>
    <!-- last: it judges the reports the modules above produced -->
    <module>test-coverage-report</module>
  </modules>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/vanillabp/businesscockpit-camunda8-adapter.git</connection>
    <developerConnection>scm:git:https://github.com/vanillabp/businesscockpit-camunda8-adapter.git</developerConnection>
    <url>https://github.com/vanillabp/businesscockpit-camunda8-adapter/tree/main</url>
  </scm>

  <!-- Where we deploy. It stays here because the build needs it, and it is taken out of the
       published POM by the flatten plugin below: it says nothing a consumer can use, and on an
       artifact which later sits on Maven Central it would point a reader at GitHub Packages. -->
  <distributionManagement>
    <snapshotRepository>
      <id>github</id>
      <name>Github Packages</name>
      <url>https://maven.pkg.github.com/vanillabp/businesscockpit-camunda8-adapter</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <version.java>21</version.java>
    <maven.compiler.release>21</maven.compiler.release>
    <jacoco.version>0.8.15</jacoco.version>
    <lombok.version>1.18.48</lombok.version>
    <spi-for-java.version>1.2.0-SNAPSHOT</spi-for-java.version>
    <adapter-platform.version>2.0.0-SNAPSHOT</adapter-platform.version>
    <!-- the Business Cockpit itself: extensions-commons is the platform-neutral half of
         this extension and is consumed as a published artifact, never copied -->
    <business-cockpit.version>0.9.0-SNAPSHOT</business-cockpit.version>
    <!-- The version of every artifact, resolved into the published POMs by the flatten
         plugin. A plain 'mvn install' builds 0.9.0-SNAPSHOT of the current GA line, which is
         what a developer of this repository wants and needs to remember no property for. A
         release of a line adds the line to it, e.g. '-Pline-8.8 -Drevision=0.9.0-8.8'. See
         README.md, section "Release lines". -->
    <revision>0.9.0-SNAPSHOT</revision>
    <!-- The release line this build produces. It is the same line scheme the VanillaBP
         Camunda 8 adapter uses, and it has to be, because this extension compiles against
         that adapter's core and against the Camunda client that adapter pins: the client a
         build was compiled against IS the lowest cluster version the build accepts. The
         properties below are what the line-* profiles select, one per line. Renovate
         leaves them alone (see renovate.json): they are raised by hand, and they follow
         the pins of vanillabp/camunda8-adapter, because the cluster the integration tests
         start is filtered out of the adapter's pin and not out of these. A pin left behind
         here does not break anything, which is what makes it worth a sentence: the tests
         then run an older client against a newer cluster, every literal that cluster
         gained arrives as UNKNOWN_ENUM_VALUE, and a fallback nobody chose reads like one
         somebody did. The night is what notices, see decision 10 in the repository's
         DECISIONS.md. -->
    <camunda8.line>8.9</camunda8.line>
    <camunda8.version>${camunda8.version.line-8.9}</camunda8.version>
    <camunda8.version.line-8.8>8.8.37</camunda8.version.line-8.8>
    <camunda8.version.line-8.9>8.9.19</camunda8.version.line-8.9>
    <camunda8.version.line-8.10>8.10.0-alpha5</camunda8.version.line-8.10>
    <!-- The VanillaBP Camunda 8 adapter this extension plugs into: it names the processing
         context the extension is wired with, and it brings the Camunda client. It is one
         version per line as soon as that adapter is released; until then every line reads the
         same snapshot. -->
    <camunda8-adapter.version>2.0.0-SNAPSHOT</camunda8-adapter.version>
    <camunda8-adapter.version.line-8.8>2.0.0-SNAPSHOT</camunda8-adapter.version.line-8.8>
    <camunda8-adapter.version.line-8.9>2.0.0-SNAPSHOT</camunda8-adapter.version.line-8.9>
    <camunda8-adapter.version.line-8.10>2.0.0-SNAPSHOT</camunda8-adapter.version.line-8.10>
    <!-- Which cluster the integration tests start is not decided here. It is decided by
         camunda8-adapter-test-support of the line this build compiles against: that artifact
         carries the image and the secondary storage of its line as a filtered resource, and
         ClusterUnderTest reads them from it. A property here would only look like it decides
         something, which is what the one that stood here did. -->
    <protobuf.version>4.36.0</protobuf.version>
    <spring-boot.version>4.1.1</spring-boot.version>

    <testcontainers.version>2.0.5</testcontainers.version>
    <quarkus.version>3.39.3</quarkus.version>
    <!-- where the build stops, the same number in every VanillaBP repository -->
    <coverage.threshold.spring-boot>85</coverage.threshold.spring-boot>
    <coverage.threshold.quarkus>85</coverage.threshold.quarkus>
    <!-- what a report is expected to show: reported every run, never asserted, so a bad
         week is not answered by editing a number -->
    <coverage.rule>90</coverage.rule>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Protobuf refuses a runtime older than the generated code linked against it, and the
           Camunda client brings generated code, while the Spring Boot BOM manages an older one
           and would win, because an imported BOM beats a transitive version. This entry stands
           BEFORE that import so every line gets it.
           It pins the classpath of THIS build and reaches no application. The published POMs
           carry no parent and no dependencyManagement since the flatten mode 'oss', so an
           application resolves protobuf from its own platform BOM, or from the client when
           nothing of its own manages it. That is why the number must not be read as a promise
           to a user. What an application has to pin itself, with the numbers of every line, is
           told once in README.md, section "Release lines". See decision 12 in the repository's
           DECISIONS.md.
           The number is the protobuf version of the NEWEST client pinned above. A runtime may
           be newer than the generated code and never older, so that one number serves every
           line, and a number per line would only lower what the older lines are tested
           against.
           So raise it whenever a camunda8.version.line-* pin moves, and read the new number
           rather than guess it:
             mvn -Pline-<id> -pl spring-boot dependency:tree -Dincludes=com.google.protobuf
           prints this pin and, as "version managed from", the version the client of that line
           was generated against. Raising it by hand is the rule the client pins follow as
           well, see decision 10 in the repository's DECISIONS.md.
           A pin left behind is easy to miss. The older lines stay green and only the newest
           line breaks, and no test run of this repository uses the preview line, neither the
           pull request nor the night. So whoever runs that line by hand sees it first, and
           what they see is the VanillaBP Camunda 8 adapter refusing to boot, with a message
           naming both versions and the entry to add. It arrives while that adapter builds its
           client, so it comes before this repository deploys anything to a cluster. -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- one place for every io.vanillabp coordinate of the Version 2 platform: the SPI an
           extension implements, the core runtime it reads its configuration from, the platform
           integrations the per-platform modules register with, and the test harness. The
           adapter SPI is in it as well: this extension reads what an adapter declared - the
           name-clash avoidance of a workflow module and the registry naming the workflow
           aggregate's id variable - although it implements nothing of it. -->
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-bom</artifactId>
        <version>${adapter-platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- the platform-neutral half of this extension, and the two modules registering it
           on Spring Boot and on Quarkus -->
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons-spring-boot</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons-quarkus</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons-quarkus-deployment</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <!-- the cockpit's own user-facing SPI: @UserTaskDetailsProvider and what a provider
           method receives -->
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>spi-for-java</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <!-- the cockpit server the integration tests of every extension repository report to,
           published by the cockpit so that this repository does not keep a copy of it -->
      <dependency>
        <groupId>io.vanillabp.businesscockpit</groupId>
        <artifactId>extensions-commons-test-support</artifactId>
        <version>${business-cockpit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.community.vanillabp</groupId>
        <artifactId>camunda8-adapter</artifactId>
        <version>${camunda8-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.community.vanillabp</groupId>
        <artifactId>camunda8-adapter-spring-boot</artifactId>
        <version>${camunda8-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.community.vanillabp</groupId>
        <artifactId>camunda8-adapter-quarkus</artifactId>
        <version>${camunda8-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.community.vanillabp</groupId>
        <artifactId>camunda8-adapter-quarkus-deployment</artifactId>
        <version>${camunda8-adapter.version}</version>
      </dependency>
      <!-- the Camunda 8 cluster the integration tests run against: the adapter publishes it
           per release line, so a line's tests here meet the cluster that line was built for -->
      <dependency>
        <groupId>org.camunda.community.vanillabp</groupId>
        <artifactId>camunda8-adapter-test-support</artifactId>
        <version>${camunda8-adapter.version}</version>
      </dependency>
      <dependency>
        <groupId>io.camunda</groupId>
        <artifactId>camunda-client-java</artifactId>
        <version>${camunda8.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-junit-jupiter</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <!-- scope 'provided', here and at every declaration a module adds: Lombok translates
           our source and has no work left once the class file exists, so no application using
           our artifacts may find it on its runtime classpath. Writing 'optional' here does not
           do that. Maven copies a managed version, scope and exclusions into a dependency and
           leaves the optional flag behind, so the POM we publish would say nothing about
           Lombok at all. No module declares Lombok today, it only stands on the compiler's
           annotationProcessorPaths, so this scope waits for the first module to declare it. -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <!-- '@{jacoco.agent}' is resolved lazily per module (late property binding),
                 forwarding coverage also into forked JVMs -->
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${version.java}</release>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- The POM an application reads is written here, and it has to stand on its own. The
           'oss' mode writes every version into it and drops the parent, and with the parent
           our dependencyManagement, our properties and our profiles. What a public
           repository asks for stays: name, description, url, licenses, developers, scm.
           Standing on its own is what a release line needs. The mode was
           'resolveCiFriendliesOnly' before, which copies this source POM and resolves
           '${revision}' and nothing else. The Camunda client then stayed a property whose
           value the active line profile sets, and an application activates no profile of
           ours, so it read the default of the file: every line published a POM asking for
           the client of the CURRENT GA line. An application on the 8.8 line was handed the
           8.9 client, and the client a build was compiled against is the lowest cluster
           version that build accepts, so the line promised a cluster it then took away.
           Read in the installed POMs of line 8.8 on 2026-09-20, and guarded since by
           Camunda8PublishedPomTest.
           The other half of the same rule: nothing an application resolves may come out of
           our dependencyManagement, because what one line needs is no business of another
           line's users. See decision 12 in the repository's DECISIONS.md. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>oss</flattenMode>
          <!-- The 'oss' mode keeps distributionManagement, and a consumer has no use for it.
               Removing it here and not from the source keeps the deployment working: this
               plugin rewrites the file which is installed and deployed, while the deploy
               plugin reads the repository from the model of the running build. -->
          <pomElements>
            <distributionManagement>remove</distributionManagement>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
      <!-- The per-line delta: code which cannot compile against every supported client, or
           which uses something only a newer cluster has. Everything else stays shared, which
           is the whole point of building the lines from one source tree. The directories are
           usually absent, and that is the intended state. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>per-line-sources</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>src/main/java-line-${camunda8.line}</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>per-line-test-sources</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <sources>
                <source>src/test/java-line-${camunda8.line}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <propertyName>jacoco.agent</propertyName>
          <excludes>
            <exclude>**/it/**</exclude>
            <exclude>**/test/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- Workflow files are excluded on purpose, the same way the other adapter
                   repositories do it: the formatter drops comments, and it unquotes version
                   numbers. -->
              <exclude>**/.github/**/</exclude>
              <exclude>.github/workflows/**</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
              <!-- the per-line delta is code like any other, so the formatter sees it too -->
              <include>src/main/java-line-*/**/*.java</include>
              <include>src/test/java-line-*/**/*.java</include>
            </includes>
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- One profile per release line. It selects the Camunda 8 adapter and the client pin, and
         with it the cluster the integration tests run against, and it names the line for the
         delta source directory. The properties above are the current GA line, so a build
         without any profile is that line: nothing to remember, and no 'activeByDefault' which
         any other profile on the command line would switch off. Rotating the lines means
         editing these profiles, the pin properties and the line table of the README, and it
         follows whatever vanillabp/camunda8-adapter does. -->
    <profile>
      <!-- previous GA: bugfixes only, ends when the next minor goes GA -->
      <id>line-8.8</id>
      <properties>
        <camunda8.line>8.8</camunda8.line>
        <camunda8.version>${camunda8.version.line-8.8}</camunda8.version>
        <camunda8-adapter.version>${camunda8-adapter.version.line-8.8}</camunda8-adapter.version>
      </properties>
    </profile>
    <profile>
      <!-- current GA: everything lands here, and it is what a plain build produces -->
      <id>line-8.9</id>
      <properties>
        <camunda8.line>8.9</camunda8.line>
        <camunda8.version>${camunda8.version.line-8.9}</camunda8.version>
        <camunda8-adapter.version>${camunda8-adapter.version.line-8.9}</camunda8-adapter.version>
      </properties>
    </profile>
    <profile>
      <!-- preview: built against the alpha of the next minor and published as a pre-release,
           so a feature only the new cluster can do is deliverable before that cluster is GA -->
      <id>line-8.10</id>
      <properties>
        <camunda8.line>8.10</camunda8.line>
        <camunda8.version>${camunda8.version.line-8.10}</camunda8.version>
        <camunda8-adapter.version>${camunda8-adapter.version.line-8.10}</camunda8-adapter.version>
        <!-- read by the client-api-changes workflow of camunda8-adapter, which turns what a
             client bump added into a red check on the GA lines and into a comment here: an
             alpha changes its classes all the time and must not hold up a pull request of
             the GA lines -->
        <camunda8.line.preview>true</camunda8.line.preview>
      </properties>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-failsafe-plugin</artifactId>
              <configuration>
                <!--
                  The REST gateway of this line drops a whole activate-jobs batch as soon as it
                  meets a task listener job whose event carries no user task action in its
                  headers. The two events without one are 'creating' and 'canceling'. So the
                  'creating' listener of a Camunda-managed user task never reaches a worker, the
                  task is never finished being created, and nothing of it reaches the cockpit.
                  The tagged tests all need such a task. They would sit in their deadline and turn
                  the line red as a whole, which hides whatever else this line might break, and a
                  line which is always red stops being read. So they are excluded here, by tag,
                  and the rest of the line keeps saying something: the deployment, the start, the
                  execution listeners, the search in the secondary storage, and the two things
                  which exist on this line alone, the cancel listener of the process and the job
                  lease.
                  The bug is camunda/camunda#58193, and gaps 2 and 4 of GAPS.md tell it from the
                  cockpit's side. The issue was closed on 2026-09-01 and 8.10.0-alpha5 was
                  published on 2026-08-31, so that alpha is older than the fix. When the pin moves
                  to a newer alpha, measure rather than assume: deploy a user task with a
                  'creating' listener, start an instance and see whether the job arrives. Once one
                  does, this exclusion and the tag go away together.
                  The same tag under the same name does the same thing in
                  vanillabp/camunda8-adapter.
                -->
                <excludedGroups>user-task-listener-jobs</excludedGroups>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <!--
                  The same bug, in the suite which runs its end-to-end tests through surefire: the
                  Quarkus test of the deployment module waits for the reports of a user task, and
                  they ride on the 'creating' listener job the gateway drops. Excluding the tag in
                  failsafe alone leaves this line red once it gets as far as that module, which is
                  where the adapter measured it. The tag marks a test which needs a user task the
                  cluster really created, in this plugin as in the one above.
                -->
                <excludedGroups>user-task-listener-jobs</excludedGroups>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <!-- For a build on a developer machine, against a Camunda 8 adapter built there by hand.
         The adapter is not released per line yet, so every line above asks for the same
         '2.0.0-SNAPSHOT' of it, and the local repository holds one adapter for all lines.
         Whoever installed last decides which line is in it, and '~/.m2' is shared between
         agents and containers. A build then compiles against another line than it says, and
         says so as a 'cannot find symbol' on a per-line class, or it does not say so at all
         and the integration tests fail as if this repository were broken.
         This profile asks for '2.0.0-<line>-SNAPSHOT' instead, which is the version the
         nightly matrix builds the adapter under, so a line gets the adapter somebody built
         for that line and nothing else resolves:
           mvn -Pline-8.8 -Drevision=2.0.0-8.8-SNAPSHOT clean install   (adapter clone)
           mvn -Pline-8.8,adapter-built-locally clean install           (here)
         It reads '${camunda8.line}', so it needs no entry per line. It has to stay BELOW
         the line profiles, because two active profiles setting one property are applied in
         the order they stand here, whatever order the command line names them in.
         And its id must not read as 'line-<number>': the nightly matrix, the release and
         bin/api-identity.sh take the live lines out of those ids, and an id like
         'line-8.x-local' would arrive as a line to build. -->
    <profile>
      <id>adapter-built-locally</id>
      <properties>
        <camunda8-adapter.version>2.0.0-${camunda8.line}-SNAPSHOT</camunda8-adapter.version>
      </properties>
    </profile>
  </profiles>
</project>
