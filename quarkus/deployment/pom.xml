<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>businesscockpit-camunda8-adapter-quarkus-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>businesscockpit-camunda8-adapter-quarkus-deployment</artifactId>
  <name>VanillaBP Business Cockpit adapter for Camunda 8 - Quarkus extension - Deployment</name>
  <description>The deployment half of the Quarkus extension: the build steps making the runtime's producer a bean, plus the test running the extension inside a Quarkus application against a real cluster.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>businesscockpit-camunda8-adapter-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc-deployment</artifactId>
    </dependency>
    <dependency>
      <!-- the deployment counterpart of every extension the runtime module uses has to be
        named here, or Quarkus refuses the descriptor -->
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons-quarkus-deployment</artifactId>
    </dependency>
    <dependency>
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-quarkus-deployment</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-internal</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the cluster these tests run against, published by the Camunda 8 adapter per release
        line, so these tests meet the cluster the active line was built for -->
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the cockpit server these tests report to, published by the Business Cockpit and
        shared with the other extension repositories -->
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <release>${version.java}</release>
              <annotationProcessorPaths>
                <path>
                  <groupId>io.quarkus</groupId>
                  <artifactId>quarkus-extension-processor</artifactId>
                  <version>${quarkus.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The tests here boot their application IN this JVM, and Quarkus logs that boot into a
            log context of its own. It happens in the Quarkus extension's beforeAll, after the
            output suppression started and before its first beforeEach, so nothing reaches it: 73
            lines in a green run, measured on 2026-09-13. Surefire writes what a test class prints
            into its report instead. No level is touched and nothing is dropped, and the build
            workflow uploads these reports when a build fails, so the full log of a red run is one
            download away. -->
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <quarkus.log.level>INFO</quarkus.log.level>
            <maven.home>${maven.home}</maven.home>
            <maven.repo>${settings.localRepository}</maven.repo>
            <!-- handed to forked Quarkus applications so that they report their coverage -->
            <jacoco.agent>${jacoco.agent}</jacoco.agent>
            <!-- A report of this repository travels through a cluster: the extension writes an
              outbox entry while a listener job is handed out, the entry is dispatched after the
              cluster's searchable storage caught up, and only then does the server see it. The
              default of the cockpit server is 30 seconds, which is the patience of a test whose
              report never leaves the application. -->
            <businesscockpit.test-server.wait-millis>240000</businesscockpit.test-server.wait-millis>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
