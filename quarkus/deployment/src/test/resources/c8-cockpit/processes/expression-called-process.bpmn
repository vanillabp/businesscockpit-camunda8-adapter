<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="ExpressionCalledDefinitions" targetNamespace="http://vanillabp.io/businesscockpit/camunda8">
  <!--
    A step of the calling case, reached by a call activity which names it by an expression. It
    lives in a file of its own, so that a test can deploy a second version of it and of nothing
    else.
  -->
  <bpmn:process id="ExpressionCalledProcess" isExecutable="true">
    <bpmn:startEvent id="ExpressionCalledStart">
      <bpmn:outgoing>ToInspect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ToInspect" sourceRef="ExpressionCalledStart" targetRef="Inspect" />
    <bpmn:userTask id="Inspect" name="Inspect the order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="inspect" />
      </bpmn:extensionElements>
      <bpmn:incoming>ToInspect</bpmn:incoming>
      <bpmn:outgoing>ToExpressionCalledEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="ToExpressionCalledEnd" sourceRef="Inspect" targetRef="ExpressionCalledEnd" />
    <bpmn:endEvent id="ExpressionCalledEnd">
      <bpmn:incoming>ToExpressionCalledEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
