<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>businesscockpit-camunda8-adapter-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>businesscockpit-camunda8-adapter-spring-boot</artifactId>
  <name>VanillaBP Business Cockpit adapter for Camunda 8 - Spring Boot</name>
  <description>Registers the Camunda 8 half of the Business Cockpit extension on Spring Boot: the wiring service injecting the listeners and opening their workers, and one bridge bean per configured Camunda 8 adapter id.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>businesscockpit-camunda8-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons-spring-boot</artifactId>
    </dependency>
    <dependency>
      <!-- the clusters this extension listens to: their clients are held per configured
        adapter id by the adapter's Spring Boot module, which is the only place the extension
        takes them from -->
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the cluster these tests run against, published by the Camunda 8 adapter per release
        line, so these tests meet the cluster the active line was built for -->
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the cockpit server these tests report to, published by the Business Cockpit and
        shared with the other extension repositories -->
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- A report of this repository travels through a cluster: the extension writes an
              outbox entry while a listener job is handed out, the entry is dispatched after the
              cluster's searchable storage caught up, and only then does the server see it. The
              default of the cockpit server is 30 seconds, which is the patience of a test whose
              report never leaves the application. -->
            <businesscockpit.test-server.wait-millis>240000</businesscockpit.test-server.wait-millis>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <!-- the tests of this module need a Camunda 8 cluster, which is what an integration
             test is: the parent already configured the plugin, the module says it runs one -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The integration tests of this module wait for a report which travelled through a
              cluster, and the cockpit server's own default is the patience of a test whose report
              never left the application. -->
            <businesscockpit.test-server.wait-millis>240000</businesscockpit.test-server.wait-millis>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
