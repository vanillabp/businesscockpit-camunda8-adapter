<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="CockpitDefinitions" targetNamespace="http://vanillabp.io/businesscockpit/camunda8">
  <bpmn:message id="StartMessage" name="StartCockpitProcess" />
  <bpmn:process id="CockpitProcess" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>ToApprove</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ToApprove" sourceRef="Start" targetRef="Approve" />
    <bpmn:userTask id="Approve" name="Approve the order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="approve" />
      </bpmn:extensionElements>
      <bpmn:incoming>ToApprove</bpmn:incoming>
      <bpmn:outgoing>ToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="ToEnd" sourceRef="Approve" targetRef="End" />
    <bpmn:endEvent id="End">
      <bpmn:incoming>ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartedByMessage">
      <bpmn:outgoing>ToMessageEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartMessageDefinition" messageRef="StartMessage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ToMessageEnd" sourceRef="StartedByMessage" targetRef="MessageEnd" />
    <bpmn:endEvent id="MessageEnd">
      <bpmn:incoming>ToMessageEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="IncidentDetailsProcess" isExecutable="true">
    <bpmn:startEvent id="IncidentStart">
      <bpmn:outgoing>ToIncidentApprove</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ToIncidentApprove" sourceRef="IncidentStart" targetRef="IncidentApprove" />
    <bpmn:userTask id="IncidentApprove" name="Approve although the details provider stumbles">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="incidentApprove" />
      </bpmn:extensionElements>
      <bpmn:incoming>ToIncidentApprove</bpmn:incoming>
      <bpmn:outgoing>ToIncidentEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="ToIncidentEnd" sourceRef="IncidentApprove" targetRef="IncidentEnd" />
    <bpmn:endEvent id="IncidentEnd">
      <bpmn:incoming>ToIncidentEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
